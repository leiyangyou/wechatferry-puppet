{
  "name": "@leiyangyou/wechatferry-puppet",
  "type": "module",
  "version": "0.0.27",
  "description": "wcferry puppet for wechaty with friendshipAccept support",
  "author": "mrrhq <sanhua@himrr.com>",
  "contributors": [
    "leiyangyou"
  ],
  "license": "MIT",
  "homepage": "https://github.com/leiyangyou/wechatferry-puppet#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/leiyangyou/wechatferry-puppet"
  },
  "keywords": [
    "wechat",
    "wcferry",
    "robot"
  ],
  "sideEffects": [
    "./src/events/index.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./dist/index.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "unbuild",
    "dev": "unbuild --stub"
  },
  "dependencies": {
    "@wechatferry/agent": "^0.0.26",
    "@wechatferry/core": "^0.0.26",
    "file-box": "^1.4.15",
    "knex": "^3.1.0",
    "p-retry": "^6.2.1",
    "unstorage": "^1.15.0",
    "wechaty-puppet": "^1.20.2",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/xml2js": "^0.4.14"
  }
}
